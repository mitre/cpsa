    ((recv (cat a n-a)) (send (cat b (enc a n-a n-b (ltk b c))))))
  (label 1)
  (parent 0)
  (realized)
  (shape)
  (maps ((0) ((c c) (a a) (b b) (k k) (n-a n-a) (n-b n-b))))
  (origs (k (0 1))))

