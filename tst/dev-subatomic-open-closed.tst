(defskeleton subatomic-open-closed
  (vars (d dev) (k skey) (n n-0 text) (o name) (pt pt-0 pt-1 pval)
    (start-ch chan))
  (defstrand dev-pass 4 (d d) (k k) (n n) (o o))
  (defstrand owner-power-dev 1 (k k) (o o) (start-ch start-ch))
  (defstrand dev-open 3 (d d) (k k) (n n-0) (o o))
  (defstrand dev-up 3 (d d) (k k) (o o) (start-ch start-ch))
  (precedes ((1 0) (3 0)) ((2 2) (0 0)) ((3 2) (2 1)))
  (uniq-orig n)
  (gen-st (cat "st" o o) (cat "st-k" o k))
  (conf start-ch)
  (auth start-ch)
  (facts (no-state-split) (useLocName))
  (leads-to ((2 2) (0 1)) ((3 1) (0 0)) ((3 1) (2 1)))
  (rule discreteBefore eff-dev-up-1 trRl_dev-up-at-1 trRl_dev-up-at-2)
